{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "next/link": "Use AppLink (@/app/components/AppLink) for type definitions or 'as' prop definitions with base path support. Use AppLinkStyled for link components to be rendered with base path support.",
              "next/image": "Use AppImage (@/app/components/AppImage) for base path support."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "app/components/AppLink.tsx",
        "app/components/AppImage.tsx",
        "app/components/AppVideo.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
